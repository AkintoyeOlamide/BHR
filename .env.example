# Copy to .env.local and fill in your values.
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Optional — server-only, never use in client code
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# App URL (used in assignment emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifications (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@vmoaeros.com
SMTP_PASS=your-app-password
EMAIL_FROM=BHR Appraisals <your-email@vmoaeros.com>
